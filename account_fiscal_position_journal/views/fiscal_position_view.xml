<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_position_form_journal" model="ir.ui.view">
        <field name="name">view.account.position.form.journal</field>
        <field name="model">account.fiscal.position</field>
        <field name="inherit_id" ref="account.view_account_position_form" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="sale_journal_id" options="{'no_create_edit': True}" />
                <field name="purchase_journal_id" options="{'no_create_edit': True}" />
            </field>
        </field>
    </record>
</odoo>
