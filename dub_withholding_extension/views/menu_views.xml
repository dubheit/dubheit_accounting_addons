<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Grouping under the "Accounting" top tab -->
    <menuitem
        id="menu_withholding_root"
        name="Withholding Taxes"
        parent="account.menu_finance_entries"
        sequence="60"
    />
    <menuitem
        id="menu_withholding_due_lines"
        name="Withholding to Pay"
        parent="menu_withholding_root"
        action="action_withholding_due_lines"
        sequence="5"
    />
    <menuitem
        id="menu_withholding_register"
        name="Register by Payment"
        parent="menu_withholding_root"
        action="action_withholding_register"
        sequence="10"
    />
    <menuitem
        id="menu_withholding_payment"
        name="Payments"
        parent="menu_withholding_root"
        action="action_withholding_payment"
        sequence="10"
    />
    <menuitem
        id="menu_withholding_history"
        name="OCA History"
        parent="menu_withholding_root"
        action="action_withholding_history_statement"
        sequence="40"
    />

    <!-- Configuration -->
    <menuitem
        id="menu_withholding_payment_type"
        name="Withholding Payment Types"
        parent="account.menu_finance_configuration"
        action="action_withholding_payment_type"
        sequence="90"
        groups="account.group_account_manager"
    />
</odoo>
