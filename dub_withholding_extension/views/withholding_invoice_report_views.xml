<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_withholding_invoice_report_list" model="ir.ui.view">
        <field name="name">withholding.invoice.report.list</field>
        <field name="model">l10n_it.withholding.invoice.report</field>
        <field name="arch" type="xml">
            <list string="Withholding Register by Invoice" create="false"
                  edit="false" delete="false">
                <field name="invoice_date" />
                <field name="partner_id" />
                <field name="invoice_id" />
                <field name="wt_kind" optional="hide" />
                <field name="tax_id" optional="show" />
                <field name="withholding_code" optional="hide" />
                <field name="reason" optional="show" />
                <field name="gross_amount" sum="Total" />
                <field name="taxable_amount" sum="Total" />
                <field name="amount" sum="Total" />
                <field name="amount_paid" sum="Total" />
                <field name="amount_residual" sum="Total" />
                <field name="source" optional="show" />
                <field name="currency_id" column_invisible="1" />
                <field name="company_id" optional="hide"
                       groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_withholding_invoice_report_pivot" model="ir.ui.view">
        <field name="name">withholding.invoice.report.pivot</field>
        <field name="model">l10n_it.withholding.invoice.report</field>
        <field name="arch" type="xml">
            <pivot string="Withholding Register by Invoice">
                <field name="partner_id" type="row" />
                <field name="invoice_date" interval="year" type="col" />
                <field name="amount" type="measure" />
                <field name="amount_residual" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="view_withholding_invoice_report_search" model="ir.ui.view">
        <field name="name">withholding.invoice.report.search</field>
        <field name="model">l10n_it.withholding.invoice.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="invoice_id" />
                <field name="tax_id" />
                <field name="reason" />
                <filter name="filter_operated" string="Operated"
                        domain="[('wt_kind', '=', 'operated')]" />
                <filter name="filter_suffered" string="Suffered"
                        domain="[('wt_kind', '=', 'suffered')]" />
                <separator />
                <filter name="filter_residual" string="With Residual"
                        domain="[('amount_residual', '!=', 0)]" />
                <separator />
                <filter name="filter_core" string="Odoo"
                        domain="[('source', '=', 'core')]" />
                <filter name="filter_oca" string="OCA History"
                        domain="[('source', '=', 'oca')]" />
                <separator />
                <filter name="filter_invoice_date" string="Invoice Date"
                        date="invoice_date" />
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Partner"
                            context="{'group_by': 'partner_id'}" />
                    <filter name="group_year" string="Invoice Year"
                            context="{'group_by': 'invoice_date:year'}" />
                    <filter name="group_reason" string="Reason"
                            context="{'group_by': 'reason'}" />
                    <filter name="group_tax" string="Withholding Tax"
                            context="{'group_by': 'tax_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_withholding_invoice_register" model="ir.actions.act_window">
        <field name="name">Register by Invoice</field>
        <field name="res_model">l10n_it.withholding.invoice.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_withholding_invoice_report_search" />
        <field name="context">{'search_default_filter_operated': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No invoices with withholding taxes.</p>
            <p>One row per invoice and withholding tax, with the amount already
               paid and the residual, from the posted invoices and from the OCA
               history.</p>
        </field>
    </record>
</odoo>
