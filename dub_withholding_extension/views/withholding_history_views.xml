<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_withholding_history_statement_list" model="ir.ui.view">
        <field name="name">withholding.history.statement.list</field>
        <field name="model">withholding.history.statement</field>
        <field name="arch" type="xml">
            <list>
                <field name="date" />
                <field name="partner_id" />
                <field name="wt_kind" />
                <field name="withholding_code" />
                <field name="reason" />
                <field name="gross_amount" sum="Total" />
                <field name="taxable_amount" sum="Total" />
                <field name="amount" sum="Total" />
                <field name="amount_paid" sum="Total" />
                <field name="currency_id" column_invisible="True" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_withholding_history_statement_form" model="ir.ui.view">
        <field name="name">withholding.history.statement.form</field>
        <field name="model">withholding.history.statement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" />
                            <field name="invoice_id" />
                            <field name="date" />
                            <field name="wt_kind" />
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="currency_id" invisible="True" />
                        </group>
                        <group>
                            <field name="withholding_code" />
                            <field name="withholding_name" />
                            <field name="reason" />
                            <field name="rate" />
                            <field name="base_coeff" />
                            <field name="oca_id" readonly="True" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="gross_amount" />
                            <field name="taxable_amount" />
                        </group>
                        <group>
                            <field name="amount" />
                            <field name="amount_paid" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Payments" name="payments">
                            <field name="move_ids">
                                <list editable="bottom">
                                    <field name="date" />
                                    <field name="partner_id" />
                                    <field name="amount" sum="Total" />
                                    <field name="state" />
                                    <field name="currency_id" column_invisible="True" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_withholding_history_statement" model="ir.actions.act_window">
        <field name="name">OCA History</field>
        <field name="res_model">withholding.history.statement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
