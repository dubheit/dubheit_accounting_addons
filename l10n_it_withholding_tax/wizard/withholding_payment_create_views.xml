<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_withholding_payment_create_form" model="ir.ui.view">
        <field name="name">withholding.payment.create.form</field>
        <field name="model">withholding.payment.create</field>
        <field name="arch" type="xml">
            <form string="Create Withholding Payment">
                <group>
                    <field name="type_id" />
                    <field name="date" />
                </group>
                <field name="line_ids">
                    <list>
                        <field name="date" />
                        <field name="move_name" />
                        <field name="partner_id" />
                        <field name="account_id" />
                        <field name="balance" />
                    </list>
                </field>
                <footer>
                    <button name="action_create" type="object" string="Create"
                            class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_withholding_payment_create" model="ir.actions.act_window">
        <field name="name">Create Withholding Payment</field>
        <field name="res_model">withholding.payment.create</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move_line" />
        <field name="binding_view_types">list</field>
    </record>

    <record id="action_withholding_payment_create_report" model="ir.actions.act_window">
        <field name="name">Create Withholding Payment</field>
        <field name="res_model">withholding.payment.create</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id"
               ref="model_l10n_it_withholding_tax_report" />
        <field name="binding_view_types">list</field>
    </record>
</odoo>
