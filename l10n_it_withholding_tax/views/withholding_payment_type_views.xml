<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_withholding_payment_type_list" model="ir.ui.view">
        <field name="name">withholding.payment.type.list</field>
        <field name="model">withholding.payment.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="codice_tributo" />
                <field name="journal_id" />
                <field name="counterpart_account_id" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_withholding_payment_type_form" model="ir.ui.view">
        <field name="name">withholding.payment.type.form</field>
        <field name="model">withholding.payment.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="codice_tributo" />
                            <field name="active" invisible="1" />
                        </group>
                        <group>
                            <field name="journal_id" />
                            <field name="counterpart_account_id" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                    </group>
                    <field name="tax_ids" widget="many2many_tags" />
                    <separator string="Derived Payable Accounts" />
                    <field name="account_ids" widget="many2many_tags"
                           help="Derived from the taxes; editable if needed." />
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_withholding_payment_type" model="ir.actions.act_window">
        <field name="name">Withholding Payment Types</field>
        <field name="res_model">withholding.payment.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
