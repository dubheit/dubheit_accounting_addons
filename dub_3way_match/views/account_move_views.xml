<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_3way_exception_banner" model="ir.ui.view">
        <field name="name">account.move.form.dub.3way.exception.banner</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning d-flex align-items-start mb-0"
                     role="alert"
                     invisible="release_to_pay != 'exception' or move_type not in ('in_invoice', 'in_refund')">
                    <i class="fa fa-exclamation-triangle me-2 mt-1"
                       title="Eccezione"
                       role="img"
                       aria-label="Eccezione"/>
                    <div class="flex-grow-1">
                        <strong>
                            Eccezione 3-way match: la fattura non corrisponde alle quantità ordinate o ricevute.
                        </strong>
                        <field name="dub_3way_exception_summary"
                               nolabel="1"
                               readonly="1"
                               class="d-block mt-1"
                               style="white-space: pre-line;"/>
                    </div>
                    <field name="release_to_pay" invisible="1"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
